system Loja {
  description "Loja de exemplo full stack: API NestJS, SPA React e infraestrutura AWS"
}

layer apresentacao match "**/*.controller.ts", "**/*.listener.ts"
layer aplicacao    match "**/*.service.ts"
layer dominio      match "**/*.entity.ts"
layer infra        match "**/*.repository.ts"

actor Visitante "Pessoa navegando sem login"

external Stripe "Pagamentos com cartão"
