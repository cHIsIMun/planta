{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Planta",
  "scopeName": "source.planta",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotation" },
    { "include": "#anchor" },
    { "include": "#string" },
    { "include": "#declaration" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.planta", "match": "///.*$" },
        { "name": "comment.line.double-slash.planta", "match": "//.*$" },
        { "name": "comment.block.planta", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "annotation": {
      "name": "meta.annotation.planta",
      "begin": "#\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.definition.annotation.planta" } },
      "endCaptures": { "0": { "name": "punctuation.definition.annotation.planta" } },
      "patterns": [
        { "include": "#string" },
        { "include": "#literals" },
        { "name": "entity.name.function.decorator.planta", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()" },
        { "name": "entity.name.function.decorator.planta", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
      ]
    },
    "anchor": {
      "name": "string.other.link.anchor.planta",
      "begin": "@\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.anchor.planta" } },
      "endCaptures": { "0": { "name": "punctuation.definition.anchor.planta" } },
      "patterns": [
        { "name": "keyword.other.scheme.planta", "match": "\\G[a-z][a-z0-9-]*:" },
        { "name": "entity.name.function.symbol.planta", "match": "(?<=#)[^\"]*" }
      ]
    },
    "string": {
      "name": "string.quoted.double.planta",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.planta", "match": "\\\\." }]
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(system|context|app|external|deployment|layer|actor|requirement|decision|rule|view)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.planta" }, "2": { "name": "entity.name.namespace.planta" } }
        },
        {
          "match": "\\b(entity|value|dto|enum|event|aggregate|service|controller|repository|gateway|middleware|guard|component|page|store|api|channel|job|process)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.planta" }, "2": { "name": "entity.name.type.planta" } }
        },
        {
          "match": "\\b(op|step)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "keyword.declaration.planta" }, "2": { "name": "entity.name.function.planta" } }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.other.http-method.planta", "match": "\\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\b" },
        { "name": "keyword.control.planta", "match": "\\b(if|else|parallel|foreach|wait|timeout|fail|return|emit|trigger|verify|must|not|may|except)\\b" },
        {
          "name": "keyword.other.planta",
          "match": "\\b(description|owner|version|match|root|contains|in|uses|calls|renders|implements|base|http|graphql|grpc|websocket|endpoint|query|mutation|subscription|rpc|message|body|param|returns|auth|roles|rateLimit|path|kind|via|on|cron|framework|route|justifiedBy|decidedBy|provider|region|source|network|zone|cluster|group|runs|stores|carries|replicas|severity|every|where|depend|have|be|of|style|title|include|exclude|layout|use|as|anchor|handler)\\b"
        },
        { "name": "support.type.primitive.planta", "match": "\\b(string|text|int|long|decimal|float|bool|uuid|date|time|datetime|duration|json|bytes|email|url|void|Map)\\b" }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.language.boolean.planta", "match": "\\b(true|false)\\b" },
        { "name": "constant.numeric.planta", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.planta", "match": "=>|->" },
        { "name": "keyword.operator.planta", "match": "[?|=]" }
      ]
    }
  }
}
